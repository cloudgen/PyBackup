    fi
    out_info "$(app_menu_text about_daily_a)$(fb_positive_int_or_default "${MAX_DAILY_BACKUPS}" 5)$(app_menu_text about_daily_b)"
    out_info "$(app_menu_text about_total_a)$(fb_positive_int_or_default "${MAX_TOTAL_BACKUPS}" 30)$(app_menu_text about_total_b)"
    _proot=$(util_resolve_projects_root 2>/dev/null || echo "")
    if [ -z "${_proot}" ]; then
        _proot=$(app_menu_text about_projects_unset)
    fi
    out_info "$(app_menu_text about_restore_a)${RESTORE_HOST_DEFAULT}$(app_menu_text about_restore_b)"
