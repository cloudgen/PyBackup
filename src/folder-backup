inst_self_update() {
    # --- Safe Variable Defaults ---
    : "${APP_NAME:=folder-backup}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${SCRIPT_URL:=}"

    # Align force aliases (CLI --force sets both)
