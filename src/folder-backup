# =============================================================================
# app_cmd_menu() - Front board (case 2 empty argv and menu / main)
# =============================================================================
#
# GENERAL PURPOSE:
# On a real terminal: ignore --json while drawing, print client-side,
# language, sudoers, and self-management, keep server-side reserved,
# run a pick. A finished leaf redisplays this board. An empty line leaves.
# Off a terminal: stop. Zero-cli-verb place lives in app_main. sudoers
# and language are not dispatcher tokens. Copy follows APP_LANG.
#
# ALIGNMENT:
# - requirement-shell-cli-default-interaction.md
# - requirement-shell-cli-sudoers-submenu.md
# - requirement-shell-cli-language.md
# - requirement-shell-interactive-vs-noninteractive.md
#
# Last updated: 2026-10-14
# =============================================================================
app_cmd_menu() {
    : "${TTY:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=folder-backup}"
    _argv_pick="${1-}"
    _argv_a="${2-}"
    _argv_b="${3-}"

    if [ "${TTY}" -ne 1 ]; then
        out_die "menu needs a terminal. Next: ${APP_NAME} help"
    fi

    _menu_json="${JSON}"
    _menu_quiet="${QUIET}"

    while true; do
        app_menu_draw_on
        out_info "$(util_app_ident) — $(app_menu_text front_title)"
        out_info "$(app_menu_text front_hide)"
        out_menu_choice 1 "$(app_menu_text cat_client)" "$(app_menu_text front_client_long)"
        out_menu_choice 5 sudoers "$(app_menu_text front_sudoers_long)"
        out_menu_choice 6 "$(app_menu_text cat_self)" "$(app_menu_text front_self_long)"
        out_menu_choice 7 "$(app_menu_text cat_language)" "$(app_menu_text front_language_long)"
        out_menu_choice 9 "$(app_menu_text word_exit)"
        if [ -n "${_argv_pick}" ]; then
            _pick="${_argv_pick}"
            _argv_pick=""
        else
            out_msg_n "$(app_menu_text line_prompt)"
            if ! read -r _prompt_line; then
                app_menu_draw_off
                unset _pick _argv_pick _argv_a _argv_b _menu_json _menu_quiet
                return 0
            fi
            _pick="${_prompt_line}"
        fi
        case "${_pick}" in
            9|99|exit|quit|Exit|QUIT|""|q|Q|離開|离开|Salir|Quitter|Beenden|終了|종료)
                app_menu_draw_off
                unset _pick _argv_pick _argv_a _argv_b _menu_json _menu_quiet
                return 0
                ;;
            1|client-side|用戶端|客户端|cliente|client|Client|クライアント|클라이언트)
                app_cmd_menu_client "${_argv_a}" "${_argv_b}"
                _argv_a=""
                _argv_b=""
                continue
                ;;
            7|language|語言|语言|idioma|langue|Sprache|sprache|言語|언어)
                app_cmd_menu_language
                _argv_a=""
                _argv_b=""
                continue
                ;;
            5|sudoers)
                app_cmd_menu_sudoers "${_argv_a}"
                _argv_a=""
                _argv_b=""
                continue
                ;;
            6|self-management|自我管理|autogestión|autogestion|Selbstverwaltung|selbstverwaltung|自己管理|자기관리)
                app_cmd_menu_self
                _argv_a=""
                _argv_b=""
                continue
                ;;
        esac
        app_menu_draw_off
        if app_menu_run_leaf "${_pick}" "${_argv_a}" "${_argv_b}"; then
            _argv_a=""
            _argv_b=""
            continue
        fi
        app_menu_draw_on
        out_error "$(app_menu_text unknown_front "${_pick}")"
        _argv_a=""
        _argv_b=""
    done
}

# app_main_menu() - Name kept for the dispatcher call sites that still say it
app_main_menu() {
    app_cmd_menu "$@"
}

