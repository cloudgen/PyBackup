        out_info "$(app_menu_text about_channel)${SCRIPT_URL}"
    else
        out_info "$(app_menu_text about_channel)$(app_menu_text about_channel_empty)"
    fi
    out_empty_line
    out_info "$(app_menu_text about_user)${_user}"
    if [ "$(id -u)" -eq 0 ]; then
        out_success "$(app_menu_text about_exec_root)"
    else
        out_info "$(app_menu_text about_exec_user)"
    fi
    out_empty_line
    _sh_show="${_shell}"
    if [ "${_shell}" = "unknown" ]; then
        _sh_show=$(app_menu_text about_word_unknown)
    fi
    out_info "$(app_menu_text about_shell)${_sh_show}"
    if [ "${TTY:-0}" -eq 1 ]; then
        out_info "$(app_menu_text about_tty_yes)"
    else
        out_info "$(app_menu_text about_tty_no)"
    fi
    out_empty_line
    out_info "$(app_menu_text cache_used_label)${EFFECTIVE_STORAGE_DIR}"
    out_info "$(app_menu_text about_cache_pref)${_cache_pref}"
    out_info "$(app_menu_text about_cache_fb1)${_cache_fb}"
    if [ -n "${_cache_fb2}" ]; then
        out_info "$(app_menu_text about_cache_fb2)${_cache_fb2}"
    fi
    out_info "$(app_menu_text about_persist)${PERSISTENT_STORAGE_DIR}"
    out_empty_line
    out_info "$(app_menu_text about_backup_root)${BACKUP_ROOT}"
    out_info "$(app_menu_text about_notation)${BACKUP_NOTATION}"
    out_info "$(app_menu_text about_deposit)${BACKUP_ROOT}/${BACKUP_NOTATION}"
    out_info "$(app_menu_text about_sudo_dep)${_sudo_deposit}"
    out_info "$(app_menu_text about_scli)${_sudoer_cli}"
    out_info "$(app_menu_text about_sadm)${_sudoer_adm}"
    if [ "${_sudoer_inbound}" = "not_found" ]; then
        out_info "$(app_menu_text about_inbound)not_found$(app_menu_text about_pref_open)${SUDOER_PUBLIC_ROOT:-/var/sudoer-cli}/sudoer-request)"
