app_about() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=folder-backup}"
    : "${VERSION:=1.26.0}"
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=folder-backup}"
    : "${SCRIPT_URL:=}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${USERNAME:=unknown}"
    : "${RESTORE_HOST_DEFAULT:=hard-disk}"
    : "${PROJECTS_ROOT:=}"
    : "${RAM_ROOT:=/dev/shm}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${BACKUP_ROOT:=/var/backup}"
    : "${BACKUP_NOTATION:=folder-backup}"
    : "${MAX_DAILY_BACKUPS:=5}"
    : "${MAX_TOTAL_BACKUPS:=30}"

    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    _cache_pref=$(util_preferred_cache_dir)
    _cache_fb=$(util_fallback_cache_dir)
    _cache_fb2=$(util_fallback2_cache_dir)
    STORAGE_DIR="${_cache_fb}"
    if [ -z "${PERSISTENT_STORAGE_DIR:-}" ]; then
        PERSISTENT_STORAGE_DIR=$(util_resolve_persistent_storage)
    fi

    _installed="false"
    inst_is_installed && _installed="true"

    _global_ver="not found"
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        _global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _local_ver="not found"
    if [ -x "${USER_BIN}/${APP_NAME}" ]; then
        _local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
    fi
    _shell=$(util_get_current_shell)
    _user=$(id -un 2>/dev/null || echo "unknown")
    _interactive="false"
    [ "${TTY:-0}" -eq 1 ] && _interactive="true"

    # Best-effort sudo deposit probe
    _sudo_deposit="unknown"
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        _sudo_deposit="root"
    elif command -v sudo >/dev/null 2>&1; then
        if sudo -n true 2>/dev/null; then
            _sudo_deposit="sudo_n_ok"
        else
            _sudo_deposit="sudo_needs_auth_or_denied"
        fi
    else
        _sudo_deposit="no_sudo"
    fi

    _sudoer_cli="not_found"
    if _scli_path=$(fb_detect_sudoer_cli); then
        _sudoer_cli="${_scli_path}"
    fi
    _sudoer_adm="absent"
    if _sadm_name=$(fb_detect_sudoer_adm); then
        _sudoer_adm="${_sadm_name}"
