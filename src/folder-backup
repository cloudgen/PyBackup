    _host_sudoers_present="false"
    _host_sudoers_path=""
    if _hsp=$(fb_probe_current_user_host_sudoers); then
        _host_sudoers_present="true"
        _host_sudoers_path="${_hsp}"
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "repo_user" "${REPO_USER}" \
            "repo_name" "${REPO_NAME}" \
            "repository" "${REPO_USER}/${REPO_NAME}" \
            "script_url" "${SCRIPT_URL}" \
            "installed" "${_installed}" \
            "global_version" "${_global_ver}" \
            "local_version" "${_local_ver}" \
            "shell" "${_shell}" \
            "interactive" "${_interactive}" \
            "user" "${_user}" \
            "cache_used" "${EFFECTIVE_STORAGE_DIR}" \
            "cache_preferred" "${_cache_pref}" \
            "cache_fallback" "${_cache_fb}" \
            "cache_fallback_2" "${_cache_fb2}" \
            "persistence_storage" "${PERSISTENT_STORAGE_DIR}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "backup_root" "${BACKUP_ROOT}" \
            "backup_notation" "${BACKUP_NOTATION}" \
            "deposit_dir" "${BACKUP_ROOT}/${BACKUP_NOTATION}" \
            "sudo_deposit" "${_sudo_deposit}" \
            "sudoers_trust_tier" "$(fb_sudoers_trust_tier)" \
            "sudoer_cli" "${_sudoer_cli}" \
            "sudoer_adm" "${_sudoer_adm}" \
            "sudoer_inbound" "${_sudoer_inbound}" \
            "sudoer_inbound_writable" "${_sudoer_inbound_writable}" \
            "host_sudoers_present" "${_host_sudoers_present}" \
            "host_sudoers_path" "${_host_sudoers_path}" \
            "max_daily_backups" "$(fb_positive_int_or_default "${MAX_DAILY_BACKUPS}" 5)" \
            "max_total_backups" "$(fb_positive_int_or_default "${MAX_TOTAL_BACKUPS}" 30)" \
            "restore_host_default" "${RESTORE_HOST_DEFAULT}" \
            "projects_root" "$(util_resolve_projects_root 2>/dev/null || echo "")" \
            "ram_root" "${RAM_ROOT}"
        return 0
    fi

    [ "${QUIET}" -eq 1 ] && return 0

    out_info "$(util_app_ident) — $(app_menu_text about_title)"
    out_empty_line
    if [ "${_installed}" = "true" ]; then
        out_success "${APP_NAME} $(app_menu_text about_ok)"
    else
        out_warn "${APP_NAME} $(app_menu_text about_not_ok)"
        out_info "   $(app_menu_text about_recommend_a)${APP_NAME} $(app_menu_text about_recommend_b)${USER_BIN}/${APP_NAME})"
    fi
    out_empty_line
    _gv_show="${_global_ver}"
    case "${_global_ver}" in
        "not found") _gv_show=$(app_menu_text about_word_missing) ;;
        unknown) _gv_show=$(app_menu_text about_word_unknown) ;;
    esac
    _lv_show="${_local_ver}"
    case "${_local_ver}" in
        "not found") _lv_show=$(app_menu_text about_word_missing) ;;
        unknown) _lv_show=$(app_menu_text about_word_unknown) ;;
    esac
    out_info "$(app_menu_text about_global_a)(${GLOBAL_BIN}/${APP_NAME}):   ${_gv_show}"
    out_info "$(app_menu_text about_local_a)(${USER_BIN}/${APP_NAME}):    ${_lv_show}"
    _tier=$(fb_sudoers_trust_tier)
