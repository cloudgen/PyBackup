# =============================================================================
#
# GENERAL PURPOSE:
# Classify this host for the cache-folder chain. Linux includes Termux and
# every host that is not Git Bash and not Mac.
#
# PRINTF EXCEPTION (class B – function return-via-stdout):
# printf is a data return for $(util_cache_host_kind), not a product message.
#
# ALIGNMENT: requirement-shell-cli-storage.md
# Test-purpose: FOLDER_BACKUP_CACHE_HOST or SELFMANAGED_CACHE_HOST
#               = linux|gitbash|mac. Do not rename SELFMANAGED_CACHE_HOST.
#               FOLDER_BACKUP_CACHE_SKIP or SELFMANAGED_CACHE_SKIP
#               = preferred skips tier 1 with no message.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Designed to be reusable in other projects.
#
# Last updated: 2026-09-27
# =============================================================================
util_cache_host_kind() {
    _cache_host_force="${FOLDER_BACKUP_CACHE_HOST:-${SELFMANAGED_CACHE_HOST:-}}"
    case "${_cache_host_force}" in
        linux|gitbash|mac)
            printf '%s' "${_cache_host_force}"
            unset _cache_host_force
            return 0
            ;;
    esac
    unset _cache_host_force
    if [ -n "${MSYSTEM:-}" ]; then
        printf '%s' "gitbash"
        return 0
    fi
    case "$(uname -s 2>/dev/null)" in
        MINGW*|MSYS*) printf '%s' "gitbash" ;;
        Darwin) printf '%s' "mac" ;;
        *) printf '%s' "linux" ;;
    esac
}

